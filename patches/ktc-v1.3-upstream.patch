diff --git a/src/target_guard.c b/src/target_guard.c
new file mode 100644
index 0000000..686a131
--- /dev/null
+++ b/src/target_guard.c
@@ -0,0 +1,61 @@
+#include "common.h"
+
+#if defined(TARGET_GUARD_MODEL) && defined(TARGET_GUARD_DEVICE) && \
+    defined(TARGET_GUARD_BUILD) && defined(TARGET_GUARD_FINGERPRINT) && \
+    defined(TARGET_GUARD_KERNEL) && defined(TARGET_GUARD_PATCH)
+
+#include <sys/system_properties.h>
+#include <sys/utsname.h>
+
+struct target_guard_property {
+  const char *name;
+  const char *expected;
+};
+
+static const struct target_guard_property target_guard_properties[] = {
+    {"ro.product.model", TARGET_GUARD_MODEL},
+    {"ro.product.device", TARGET_GUARD_DEVICE},
+    {"ro.build.display.id", TARGET_GUARD_BUILD},
+    {"ro.build.fingerprint", TARGET_GUARD_FINGERPRINT},
+    {"ro.build.version.security_patch", TARGET_GUARD_PATCH},
+#if defined(TARGET_GUARD_ANDROID_RELEASE)
+    {"ro.build.version.release", TARGET_GUARD_ANDROID_RELEASE},
+#endif
+#if defined(TARGET_GUARD_SDK)
+    {"ro.build.version.sdk", TARGET_GUARD_SDK},
+#endif
+#if defined(TARGET_GUARD_SALES_CODE)
+    {"ro.csc.sales_code", TARGET_GUARD_SALES_CODE},
+    {"ro.boot.sales_code", TARGET_GUARD_SALES_CODE},
+#endif
+};
+
+__attribute__((constructor(101))) static void target_guard_verify(void) {
+  for (size_t i = 0;
+       i < sizeof(target_guard_properties) / sizeof(target_guard_properties[0]);
+       i++) {
+    const struct target_guard_property *check = &target_guard_properties[i];
+    char actual[PROP_VALUE_MAX];
+    int len = __system_property_get(check->name, actual);
+    if (len < 0) {
+      actual[0] = '\0';
+    }
+    if (strcmp(actual, check->expected) != 0) {
+      fprintf(stderr, "[!] target guard mismatch %s: got=%s expected=%s\n",
+              check->name, actual, check->expected);
+      fflush(NULL);
+      _exit(1);
+    }
+  }
+
+  struct utsname uts;
+  if (uname(&uts) != 0 || strcmp(uts.release, TARGET_GUARD_KERNEL) != 0) {
+    fprintf(stderr, "[!] target guard kernel release mismatch\n");
+    fflush(NULL);
+    _exit(1);
+  }
+
+  printf("[+] target guard exact firmware and boot checks passed\n");
+}
+
+#endif
